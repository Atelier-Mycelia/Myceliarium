:root {
    --rainbow-tex: resource('Editor/Textures/rainbowTex');
}

.tabRoot {
    justify-content: center;
    height: 60px;
    flex-direction: row;
}

.tabButton {
    width: 60%;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    border-radius: 5px;
    padding-top: 3px;
    padding-right: 5px;
    padding-bottom: 3px;
    padding-left: 5px;
    margin: 0 0 0 0;
    font-size: 24px;
}

.tabButton > Image {
    width: 20%;
    margin-right: 5px;
}

.tabLabel {
    height: 100%;
    -unity-text-align: middle-center;
    font-size: 24px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 1px;
    padding-right: 1px;
    padding-bottom: 1px;
    padding-left: 1px;
    width: 70%;
}

.tabIcon {
    background-image: var(--rainbow-tex);
    -unity-background-scale-mode: stretch-to-fill;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-right: 15px;
}

.tabIconHolder {
    padding-top: 3px;
    padding-right: 3px;
    padding-bottom: 3px;
    padding-left: 3px;
}

.tab-selected {
    background-color: rgba(255, 255, 255, 0.1);
}
