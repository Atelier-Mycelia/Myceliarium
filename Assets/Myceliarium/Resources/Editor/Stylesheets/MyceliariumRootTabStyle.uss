:root {
    --tab-selected-color: rgb(44, 93, 135);
    --tab-selected-text-color: rgb(222, 222, 222);
    --tab-normal-text-color: rgb(222, 222, 222);
    --tab-normal-bg-color: rgb(60, 60, 60);
    --default-icon: resource('Editor/Icons/defaultTabIcon');
    --mascot-icon: resource('Editor/Icons/nelSideMugshotIcon_01');
    --default-icon-left-offset: 10px;
    --default-icon-width: 60px;
}

.tabRoot {
    height: 60px;
    flex-direction: row;
    margin-bottom: 5px;
    color: var(--tab-normal-text-color);
    background-color: var(--tab-normal-bg-color);
}

.tabButton {
    font-size: 32px;
    padding-left: 50px;
    justify-content: center;
    -unity-text-align: middle-center;
    
    
    border-color: rgb(30, 30, 30);
    border-width: 2px;
    transition-property: background-color;
    transition-duration: 0.2s;
    width: 100%;
    flex-direction: column;
    height: 60px;
    flex-grow: 0;
}

.tabButton > Toggle {
    height: 100%;
}

.tabButton > Toggle > VisualElement {
    height: 100%;
}

.tabButton > Toggle > VisualElement > Label {
    scale: 0.9 1;
}

.unity-toggle__checkmark {
    visibility: hidden;
    opacity: 0;
    display: none;
}

.tabIcon {
    background-image: var(--mascot-icon);
    -unity-background-scale-mode: scale-to-fit;
    background-position-y: bottom; 
    /* ^Prevents empty space below the icon that wasn't in the source image. */

    height: 100%;
    width: 100%;
}

.tabIconHolder
{
    padding: 5px 0px 2px 0px;
    margin: 0px 0px 0px 3px;
    width: 60px;
}

.selected {
    background-color: var(--tab-selected-color);
    color: var(--tab-selected-text-color);
}
