:root {

    --tab-selected-color: rgb(44, 93, 135);
    --tab-selected-text-color: rgb(222, 222, 222);
    --tab-normal-text-color: rgb(222, 222, 222);
    --tab-normal-bg-color: rgb(60, 60, 60);
    --hover-color: rgb(100, 100, 100);
    --active-color: rgb(50, 50, 50);
    --normal-border-color: rgb(30, 30, 30);
    --selected-border-color: rgb(100, 140, 200);
    --hyphlow-tab-icon: resource("Editor/Icons/hyphlowLogo_noText");
    --border-color: rgb(30, 30, 30);
    --height: 60px;
    --label-font-size: 24px;
    --border-width: 2px;
    --border-radius: 5px;
    --button-height: 100px;
    
    --default-icon: resource('Editor/Icons/defaultTabIcon');
    --mascot-icon: resource('Editor/Icons/nelSideMugshotIcon_01_aiGen');
    --logo-icon: resource('Editor/Icons/myceliariumLogo_aiGen');
    --default-icon-left-offset: 10px;
    --default-icon-width: 60px;
}

.tabRoot {
    height: var(--height);
    flex-direction: row;
    margin: 0px 0px 0px 0px;
    color: var(--tab-normal-text-color);
    background-color: var(--tab-normal-bg-color);
}

.tabButton {
    padding-left: 40px;
    justify-content: center;
    -unity-text-align: middle-center;
    
    border-color: var(--normal-border-color);
    border-width: var(--border-width);
    border-radius: var(--border-radius);
    transition-property: background-color;
    transition-duration: 0.2s;
    width: 100%;
    flex-direction: column;
    flex-grow: 0;
}

.tabButton > Toggle {
    height: 100%;
}

.tabButton > Toggle > VisualElement {
    height: 100%;
}

.tabButton > Toggle > VisualElement > Label {
    scale: 0.9 1;
}

.unity-toggle__checkmark {
    visibility: hidden;
    opacity: 0;
    display: none;
}

.tabIcon {
    /* background-image: var(--mascot-icon); */
    background-image: var(--logo-icon);
    -unity-background-scale-mode: scale-to-fit;
    background-position-y: center; 
    /* If the icon is a mascot, best set this to bottom. The idea is to prevent
     empty space below the icon that wasn't in the source image. */

    height: 100%;
    width: 100%;
}

.tabIconHolder
{
    padding: 5px 5px 2px 5px;
    margin: 0px 0px 0px 3px;
    width: 60px;
}

.selected {
    background-color: var(--tab-selected-color);
    border-color: var(--selected-border-color);
    color: var(--tab-selected-text-color);
}

.tabRoot > Toggle {
    height: 100%;
}

.tabRoot > Toggle > VisualElement {
    height: 100%;
}

/* Room for the icon, on the header instead of the Foldout so subtabs aren't indented */
.tabRoot.tab-foldout-root > .unity-foldout > .unity-toggle {
    padding-left: 50px;
}

.tabRoot > Toggle > VisualElement > Label {
    font-size: var(--label-font-size);
    flex-grow: 1;
    height: 100%;
    -unity-text-align: middle-center;
}

.tabRoot:hover {
    border-color: var(--selected-border-color);
}

.tabRoot:active {
    background-color: var(--active-color);
}

.tabRoot.selected {
    background-color: var(--tab-selected-color);
    border-color: var(--selected-border-color);
}
