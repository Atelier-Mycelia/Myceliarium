:root {
    --language-label-font-size: 24px;
    --language-dropdown-font-size: 24px;
    --button-font-size: 24px;
    --dropdown-width: 200px;
}

.root {
    width: 1280px;
    height: 800px;
    flex-direction: column;
}

.main-container {
    flex-direction: row;
    flex-grow: 1;
    width: 100%;
    height: 90%;
    padding: 8px;
}

.main-tab-set {
    width: 256px; /* 20% of 1280 */
    height: 100%;
    flex-direction: column;
    padding: 6px;
    border-right-width: 2px;
    border-right-color: #333;
}

.main-tab {
    height: 32px;
    margin-bottom: 4px;
}

.subtab-container {
    margin-left: 12px;
    flex-direction: column;
}

.subtab {
    height: 28px;
    margin-bottom: 3px;
}

.category-display {
    flex-grow: 1;
    padding: 8px;
}

.bottom-bar {
    flex-direction: row;
    flex-grow: 1;
    align-items: stretch;
    justify-content: space-between;
    padding: 8px;
    border-top-width: 2px;
    border-top-color: #333;
}

.bottom-control-left {
    margin-right: 12px;
    flex-grow: 0;
    align-self: stretch;
}

.bottom-control-left .unity-base-field__label {
    -unity-text-align: middle-center;
    min-width: auto;
    font-size: var(--language-label-font-size);
    margin-right: 8px;
}

.bottom-control-left .unity-text-element {
    -unity-text-align: middle-center;
}

.bottom-control-left .unity-base-popup-field__input {
    width: var(--dropdown-width);
}

.bottom-control-left .unity-base-popup-field__text {
    padding-left: 8px;
    font-size: var(--language-dropdown-font-size);
}

.bottom-spacer {
    flex-grow: 1;
}

.bottom-control-right {
    margin-left: 8px;
    flex-grow: 0;
    align-self: stretch;
    width: 150px;
    font-size: var(--button-font-size);
}
