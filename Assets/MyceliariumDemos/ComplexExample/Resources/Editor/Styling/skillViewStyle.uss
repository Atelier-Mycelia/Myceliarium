:root
{
	--label-width: 90px;
	--field-min-width: 190px;
	--section-border-color: rgba(0, 0, 0, 0.45);
	--section-background-color: rgba(0, 0, 0, 0.12);
}

.skill-view
{
	flex-direction: row;
	flex-grow: 1;
	align-items: flex-start;
	padding: 4px;
}

.column
{
	flex-direction: column;
	flex-basis: 0px;
	min-width: 0px;
	margin: 0px 4px 0px 4px;
}

.column-wide
{
	flex-grow: 3;
}

.column-narrow
{
	flex-grow: 2;
}

.section
{
	padding: 6px 8px 8px 8px;
	margin-bottom: 8px;
	border-width: 1px;
	border-radius: 4px;
	border-color: var(--section-border-color);
	background-color: var(--section-background-color);
}

.section-header
{
	-unity-font-style: bold;
	font-size: 13px;
	margin-bottom: 4px;
}

/* Fields that don't fit next to each other wrap onto the next line */
.row
{
	flex-direction: row;
	flex-wrap: wrap;
}

.row-top-aligned
{
	align-items: flex-start;
}

/*
 * The icon is shown in a 64x64 box (like RPG Maker's) rather than as a regular object
 * field. It's still an ObjectField underneath, so dropping a sprite on the box works, and
 * clicking anywhere on it opens the picker. SkillView adds the preview image.
 */
.icon-picker
{
	flex-grow: 0;
	flex-shrink: 0;
	width: 64px;
	height: 64px;
	margin: 2px 8px 2px 0px;
}

.icon-picker > .unity-object-field__input
{
	flex-grow: 1;
	height: 64px;
	margin: 0px;
	padding: 0px;
	border-radius: 4px;
	background-color: rgba(0, 0, 0, 0.25);
}

.icon-picker .unity-object-field-display__icon,
.icon-picker .unity-object-field-display__label
{
	display: none;
}

/* The picker button, stretched over the whole box and invisible, so a click anywhere opens the picker */
.icon-picker .unity-object-field__selector
{
	position: absolute;
	left: 0px;
	top: 0px;
	right: 0px;
	bottom: 0px;
	width: auto;
	height: auto;
	opacity: 0;
}

.icon-preview
{
	position: absolute;
	left: 4px;
	top: 4px;
	right: 4px;
	bottom: 4px;
	-unity-background-scale-mode: scale-to-fit;
}

.field
{
	flex-grow: 1;
	flex-shrink: 1;
	min-width: var(--field-min-width);
	margin: 2px 4px 2px 0px;
}

.field > Label
{
	min-width: var(--label-width);
	width: var(--label-width);
}

.multiline-field
{
	height: 64px;
}

.multiline-field > Label
{
	-unity-text-align: upper-left;
}

.multiline-field > #unity-text-input
{
	white-space: normal;
	-unity-text-align: upper-left;
}

.note-field
{
	height: 140px;
}
