:root
{
	--sexual-history-section-height: 200px;

	--mugshot-section-width: 300px;
	--mugshot-section-height: 200px;

	--mugshot-section-padding: 0px 0px 0px 0px;
	--mugshot-section-margin: 3px 0px 0px 0px;

	--first-row-entry-width: 150px;
	--first-row-entry-height: 40px;

	--little-to-the-sides: 0px 5px 0px 5px;
	--closer-to-name-label: -75px;

	--sidebar-width: 220px;

	padding: 10px;
}

.header
{
	font-size: 24px;
	-unity-text-align: middle-center;
}

.sidebar
{
	display: flex;
	flex-direction: column;
	width: var(--sidebar-width);
	min-width: var(--sidebar-width);
	flex-shrink: 0;
	border-right-width: 2px;
	border-right-color: black;
	margin-right: 10px;
}

.controls
{
	width: 100%;
	height: 50px;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	padding: 5px;
}

.control-button
{
	width: 100px;
	height: 100%;
	margin: 0px 5px 0px 5px;
	align-self: center;
}

.entry-list
{
	flex-grow: 1;
	width: 100%;
}

.detail-holder
{
	flex-grow: 1;
	flex-direction: column;
}